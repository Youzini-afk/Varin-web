---
import DownloadButton from '~/components/DownloadButton.astro';
import Mark from '~/components/Mark.astro';
import ThemeSwitch from '~/components/ThemeSwitch.astro';
import { copyFor, localePath, otherLocale, type Locale } from '~/i18n';
import { DOCS_URL, REPO_URL } from '~/site';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const t = copyFor(locale).nav;
const home = localePath(locale, '/');
const anchor = (id: string): string => (path === '/' ? `#${id}` : `${home}#${id}`);
const alternate = otherLocale(locale);
---
<header class="nav" data-nav>
  <a class="brand" href={home} aria-label="Varin">
    <Mark class="brand-mark" />
    <span>Varin</span>
  </a>
  <nav class="links" aria-label={t.primary}>
    <a href={anchor('team')}>{t.team}</a>
    <a href={anchor('modes')}>{t.modes}</a>
    <a href={anchor('bot')}>{t.bot}</a>
    <a href={anchor('harness')}>{t.harness}</a>
    <a href={anchor('extensions')}>{t.extensions}</a>
    <a href={DOCS_URL[locale]}>{t.docs}</a>
  </nav>
  <div class="actions">
    <ThemeSwitch locale={locale} />
    <a class="lang" href={localePath(alternate, path)} hreflang={copyFor(alternate).meta.lang} lang={copyFor(alternate).meta.lang} title={t.language.otherName} aria-label={`${t.language.label}: ${t.language.otherName}`}>
      <b>{t.language.current}</b><span aria-hidden="true"> / </span>{t.language.other}
    </a>
    <a class="gh" href={REPO_URL}>{t.github}</a>
    <DownloadButton locale={locale} size="sm" short />
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const update = (): void => { nav.classList.toggle('is-scrolled', window.scrollY > 24); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px var(--gutter);
  }
  /* The glass background fades in on a pseudo element, so only opacity animates. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--glass);
    box-shadow: 0 1px 0 var(--hair);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    opacity: 0;
    transition: opacity var(--t-slow) var(--ease);
  }
  .nav.is-scrolled::before { opacity: 1; }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
  .brand :global(.brand-mark) { width: 22px; height: 22px; transition: transform var(--t-slow) var(--ease); }
  .brand:hover :global(.brand-mark) { transform: rotate(-90deg); }
  .links { display: flex; gap: 26px; font-size: 13.5px; color: var(--muted); }
  .links a { position: relative; transition: color var(--t-fast) var(--ease); }
  .links a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--t-normal) var(--ease); }
  .links a:hover { color: var(--ink); }
  .links a:hover::after { transform: scaleX(1); }
  .actions { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--muted); }
  .lang { font-size: 12.5px; letter-spacing: 0.02em; transition: color var(--t-fast) var(--ease); }
  .lang b { color: var(--ink); font-weight: 600; }
  .lang:hover, .gh:hover { color: var(--ink); }
  .gh { transition: color var(--t-fast) var(--ease); }

  @media (max-width: 1080px) {
    .links { display: none; }
  }
  @media (max-width: 640px) {
    .gh, .lang { display: none; }
  }
</style>
