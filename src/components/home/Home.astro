---
import Assurance from '~/components/home/Assurance.astro';
import Bot from '~/components/home/Bot.astro';
import Closing from '~/components/home/Closing.astro';
import Extensions from '~/components/home/Extensions.astro';
import Harness from '~/components/home/Harness.astro';
import Hero from '~/components/home/Hero.astro';
import Modes from '~/components/home/Modes.astro';
import Ready from '~/components/home/Ready.astro';
import Team from '~/components/home/Team.astro';
import type { Locale } from '~/i18n';
import Base from '~/layouts/Base.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<Base locale={locale} path="/">
  <Hero locale={locale} />
  <div class="lead"><Harness locale={locale} /></div>
  <div class="rule"></div>
  <Ready locale={locale} />
  <div class="rule"></div>
  <Modes locale={locale} />
  <div class="rule"></div>
  <Team locale={locale} />
  <div class="rule"></div>
  <Bot locale={locale} />
  <div class="rule"></div>
  <Extensions locale={locale} />
  <div class="rule"></div>
  <Assurance locale={locale} />
  <Closing locale={locale} />
</Base>

<style>
  /* The first section arrives while the hero's floor is still dissolving, instead of after a blank screen.
     The hero track is 140vh longer than a screen (120vh on phones); half of that overlaps here. */
  .lead { position: relative; z-index: 1; }
  /* With reduced motion the hero is a single static screen, so the first section keeps its normal spacing. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .lead { margin-top: -70vh; }
    :global(html.js) .lead > :global(.section) { padding-top: 48px; }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    :global(html.js) .lead { margin-top: -60vh; }
  }
</style>
