---
/** Small animated glyphs for the harness honeycomb. Each animates only transform, opacity or stroke offset. */
interface Props { name: string }
const { name } = Astro.props;
---
<svg class="hi" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'output' && (<><path d="M4 5h16M4 8.5h12" /><circle class="fill a-dot" cx="8" cy="12.2" r="1.1" /><circle class="fill a-dot" cx="12" cy="12.2" r="1.1" /><circle class="fill a-dot" cx="16" cy="12.2" r="1.1" /><path d="M4 16h14M4 19.5h9" /></>)}
  {name === 'prepare' && (<><path d="M12 4.5a7.5 7.5 0 1 1 0 15a7.5 7.5 0 1 1 0-15" opacity="0.28" /><path class="a-ring sage" pathLength="1" d="M12 4.5a7.5 7.5 0 1 1 0 15a7.5 7.5 0 1 1 0-15" /><path d="M9.5 12h5" /></>)}
  {name === 'tokens' && (<><rect class="a-tally fill" x="5" y="6" width="1.8" height="12" rx="0.9" /><rect class="a-tally fill" x="9" y="6" width="1.8" height="12" rx="0.9" /><rect class="a-tally fill" x="13" y="6" width="1.8" height="12" rx="0.9" /><rect class="a-tally fill" x="17" y="6" width="1.8" height="12" rx="0.9" /><path class="sage" d="M3.5 16 20.5 8" /></>)}
  {name === 'memory' && (<><path d="M7 3.5h10v17l-5-3.6-5 3.6Z" /><path d="M10 8h4" /><circle class="fill sage a-save" cx="18.5" cy="5" r="2.2" /></>)}
  {name === 'tools' && (<><rect x="4" y="9.5" width="16" height="10.5" rx="2.2" /><path d="M4 13.5h16" opacity="0.5" /><rect class="a-pop cover" x="7" y="4" width="10" height="7" rx="1.8" /></>)}
  {name === 'context' && (<><path class="sage" d="M4 5.5h16" /><path class="a-squeeze" d="M4 10h16" /><path class="a-squeeze" d="M4 14h16" /><path d="M4 18.5h11" /></>)}
  {name === 'mcp' && (<><path d="M5 4h14" opacity="0.45" /><g class="a-plug"><path d="M9.5 9.5V5.5M14.5 9.5V5.5" /><rect x="7" y="9.5" width="10" height="6.5" rx="2" /><path d="M12 16v4.5" /></g></>)}
  {name === 'isolation' && (<><rect x="4" y="4" width="11" height="11" rx="2.2" opacity="0.45" /><rect class="a-copy cover" x="9" y="9" width="11" height="11" rx="2.2" /></>)}
  {name === 'team' && (<><path d="M12 8.4 7.3 15.6M12 8.4l4.7 7.2M8.6 17.5h6.8" opacity="0.55" /><circle cx="12" cy="6" r="2.4" /><circle cx="6" cy="17.5" r="2.4" /><circle cx="18" cy="17.5" r="2.4" /><circle class="fill sage" r="1.4"><animateMotion dur="4.2s" repeatCount="indefinite" path="M12 6 L6 17.5 L18 17.5 Z" /></circle></>)}
  {name === 'durable' && (<><rect x="5" y="3.5" width="14" height="17" rx="2.2" /><path class="a-log" d="M8.5 8h7" /><path class="a-log" d="M8.5 12h7" /><path class="a-log" d="M8.5 16h4.5" /></>)}
  {name === 'ask' && (<><g class="a-q"><path d="M5 4.5h14a1 1 0 0 1 1 1V13a1 1 0 0 1-1 1h-7.5L7.5 17v-3H5a1 1 0 0 1-1-1V5.5a1 1 0 0 1 1-1Z" /><path d="M10.4 7.6a1.7 1.7 0 1 1 2.4 1.6c-.5.2-.8.6-.8 1.1M12 11.9v.1" /></g><path class="sage a-dash" d="M4 20.5h16" /></>)}
  {name === 'multirun' && (<><path d="M4 6.5h16M4 12h16M4 17.5h16" opacity="0.3" /><circle class="fill a-lane" cx="5.5" cy="6.5" r="1.7" style="--t:1.8s" /><circle class="fill a-lane" cx="5.5" cy="12" r="1.7" style="--t:2.6s" /><circle class="fill sage a-lane" cx="5.5" cy="17.5" r="1.7" style="--t:2.1s" /></>)}
  {name === 'goals' && (<><path d="M6.5 21V3.5" /><path class="a-flag" d="M6.5 4.5h11l-2.6 3.6 2.6 3.6h-11Z" /><path class="sage a-dash" d="M10 18.5h10" /></>)}
  {name === 'replay' && (<><path d="M19 12a7 7 0 1 1-2.6-5.45" /><path d="m17.2 3.2.2 3.9-3.9.3" /><rect class="fill a-blink" x="9.6" y="9.6" width="4.8" height="4.8" rx="1" /></>)}
  {name === 'retry' && (<g class="a-retry"><path d="M18.5 9.5A7 7 0 0 0 5.6 8.7M5.5 14.5a7 7 0 0 0 12.9.8" /><path d="M5.2 4.8v4h4M18.8 19.2v-4h-4" /></g>)}
  {name === 'script' && (<><circle cx="5.5" cy="12" r="2" /><path class="a-draw" pathLength="1" d="M7.5 12c3 0 3-6 6-6h3" /><path class="a-draw l2" pathLength="1" d="M7.5 12h9" /><path class="a-draw l3" pathLength="1" d="M7.5 12c3 0 3 6 6 6h3" /><circle class="fill sage" cx="18.5" cy="6" r="1.6" /><circle class="fill sage" cx="18.5" cy="12" r="1.6" /><circle class="fill sage" cx="18.5" cy="18" r="1.6" /></>)}
  {name === 'timeline' && (<><path d="M3 15h18" opacity="0.5" /><circle class="cover" cx="6" cy="15" r="2" /><circle class="cover" cx="10" cy="15" r="2" /><circle class="cover" cx="14" cy="15" r="2" /><circle class="cover" cx="18" cy="15" r="2" /><path class="sage a-rewind" d="M18 4.5v6.5" /><circle class="fill sage a-rewind" cx="18" cy="15" r="2.8" /></>)}
  {name === 'permissions' && (<><path d="M12 3.5 19 6v5.5c0 4.3-3 7.5-7 9-4-1.5-7-4.7-7-9V6Z" /><path class="a-check sage" pathLength="1" d="m8.8 12 2.3 2.3 4.2-4.6" /></>)}
</svg>

<style>
  .hi { width: calc(var(--hw) * 0.19); height: calc(var(--hw) * 0.19); margin-bottom: 4px; color: var(--ink); fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hi * { transform-box: view-box; }
  .fill { fill: currentColor; stroke: none; }
  .sage { stroke: var(--sage); }
  .fill.sage { fill: var(--sage); }
  .cover { fill: var(--hex-bg, var(--card)); }

  .a-pop { animation: a-pop 3.4s var(--ease) infinite; }
  @keyframes a-pop { 0%, 55%, 100% { transform: none; } 20%, 42% { transform: translateY(-3px); } }
  .a-squeeze { transform-box: fill-box; transform-origin: left center; animation: a-squeeze 4s var(--ease) infinite; }
  @keyframes a-squeeze { 0%, 20%, 100% { transform: none; } 40%, 80% { transform: scaleX(0.38); } }
  .a-log { transform-box: fill-box; transform-origin: left center; animation: a-log 3.6s var(--ease) infinite; }
  .a-log:nth-of-type(2) { animation-delay: 0.35s; }
  .a-log:nth-of-type(3) { animation-delay: 0.7s; }
  @keyframes a-log { 0% { transform: scaleX(0.15); } 22%, 88% { transform: scaleX(1); } 100% { transform: scaleX(0.15); } }
  .a-flag { transform-box: fill-box; transform-origin: left center; animation: a-flag 1.8s ease-in-out infinite; }
  @keyframes a-flag { 0%, 100% { transform: scaleX(1) skewY(0); } 50% { transform: scaleX(0.86) skewY(6deg); } }
  .a-blink { animation: a-blink 2.4s steps(1) infinite; }
  @keyframes a-blink { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0.15; } }
  .a-dot { animation: a-dot 1.8s ease-in-out infinite; }
  .a-dot:nth-of-type(2) { animation-delay: 0.2s; }
  .a-dot:nth-of-type(3) { animation-delay: 0.4s; }
  @keyframes a-dot { 0%, 100% { opacity: 0.2; } 40% { opacity: 1; } }
  .a-ring { stroke-dasharray: 1; transform-origin: 12px 12px; transform: rotate(-90deg); animation: a-ring 4.2s var(--ease) infinite; }
  @keyframes a-ring { 0% { stroke-dashoffset: 1; } 70%, 100% { stroke-dashoffset: 0; } }
  .a-tally { transform-box: fill-box; transform-origin: center bottom; animation: a-tally 3.2s var(--ease) infinite; }
  .a-tally:nth-of-type(2) { animation-delay: 0.18s; }
  .a-tally:nth-of-type(3) { animation-delay: 0.36s; }
  .a-tally:nth-of-type(4) { animation-delay: 0.54s; }
  @keyframes a-tally { 0% { transform: scaleY(0.3); } 20%, 85% { transform: scaleY(1); } 100% { transform: scaleY(0.3); } }
  .a-save { transform-box: fill-box; transform-origin: center; animation: a-save 3s var(--ease) infinite; }
  @keyframes a-save { 0%, 30% { transform: scale(0); } 45% { transform: scale(1.3); } 55%, 90% { transform: scale(1); } 100% { transform: scale(0); } }
  .a-plug { animation: a-plug 3s var(--ease) infinite; }
  @keyframes a-plug { 0%, 100% { transform: translateY(2.5px); } 40%, 75% { transform: none; } }
  .a-copy { animation: a-copy 3.6s var(--ease) infinite; }
  @keyframes a-copy { 0%, 15%, 100% { transform: translate(-3px, -3px); } 40%, 80% { transform: none; } }
  .a-dash { stroke-dasharray: 3 4; animation: a-dash 1.2s linear infinite; }
  @keyframes a-dash { to { stroke-dashoffset: -7; } }
  .a-q { transform-box: fill-box; transform-origin: center bottom; animation: a-q 3.2s var(--ease) infinite; }
  @keyframes a-q { 0%, 100% { transform: scale(0.92); } 20%, 60% { transform: scale(1.06); } }
  .a-lane { animation: a-lane var(--t, 2.4s) ease-in-out infinite alternate; }
  @keyframes a-lane { from { transform: translateX(0); } to { transform: translateX(13px); } }
  .a-retry { transform-origin: 12px 12px; animation: a-retry 4s var(--ease) infinite; }
  @keyframes a-retry { 0% { transform: rotate(0); } 18%, 30% { transform: rotate(360deg); } 52%, 100% { transform: rotate(720deg); } }
  .a-draw { stroke-dasharray: 1; animation: a-draw 3.6s var(--ease) infinite; }
  .l2 { animation-delay: 0.2s; }
  .l3 { animation-delay: 0.4s; }
  @keyframes a-draw { 0% { stroke-dashoffset: 1; } 35%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
  .a-rewind { animation: a-rewind 4.4s var(--ease) infinite; }
  @keyframes a-rewind { 0%, 15%, 100% { transform: translateX(0); } 35%, 70% { transform: translateX(-8px); } }
  .a-check { stroke-dasharray: 1; animation: a-check 3.4s var(--ease) infinite; }
  @keyframes a-check { 0%, 20% { stroke-dashoffset: 1; } 45%, 90% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 1; } }
</style>
