---
import { copyFor, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copyFor(locale).bot;
// A recording of the product's Bot stage. Public files are referenced from the site root, like the favicons in Base.astro.
const clip = { src: '/media/varin-at-work.mp4', poster: '/media/varin-at-work-poster.webp', width: 716, height: 468 };
---
<section class="section split" id="bot" aria-labelledby="bot-title" data-live>
  <div>
    <p class="kicker" data-reveal>{t.kicker}</p>
    <h2 class="title" id="bot-title" data-reveal style="--d:60ms">{t.title}</h2>
    <p class="desc" data-reveal style="--d:120ms">{t.desc}</p>
    <ul class="feats" data-reveal style="--d:180ms">{t.feats.map((feat) => <li>{feat}</li>)}</ul>
  </div>

  <div class="card botcard" data-reveal style="--d:120ms" data-bot-demo>
    <input class="vh" type="radio" name="bot-state" id="bot-awake" value="awake" checked />
    <input class="vh" type="radio" name="bot-state" id="bot-sleep" value="sleep" />
    <input class="vh" type="radio" name="bot-state" id="bot-wake" value="wake" />
    <div class="states" role="radiogroup" aria-label={t.states.label}>
      <label for="bot-awake"><i></i>{t.states.awake}</label>
      <label for="bot-sleep"><i></i>{t.states.sleep}</label>
      <label for="bot-wake"><i></i>{t.states.wake}</label>
    </div>

    <div class="stage">
      {/* No controls and no autoplay attribute: the script below plays it only while it is on screen. */}
      <video
        src={clip.src}
        poster={clip.poster}
        width={clip.width}
        height={clip.height}
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        aria-label={t.video}
        data-bot-video
      ></video>
    </div>

    <div class="profile">{t.profile.map((item) => <span>{item.label}<b>{item.value}</b></span>)}</div>
    <ul class="works">
      {t.works.map((work, index) => (
        <li>
          {work.title}
          <span class="st">
            <b class:list={['s-awake', { 's-ask': work.ask }]}>{work.awake}</b>
            <b class="s-sleep">{t.status.sleep}</b>
            <b class="s-wake">{t.status.wake}</b>
          </span>
          {!work.ask && <i style={`--d:${-2 - index * 4}s`}></i>}
        </li>
      ))}
    </ul>
    <div class="mem">{t.memory.map((item) => <span>{item}<em>{t.fix}</em><em>{t.forget}</em></span>)}</div>
  </div>
</section>

<script>
  import { onReducedMotionChange, prefersReducedMotion } from '~/lib/motion/preferences';

  const demo = document.querySelector<HTMLElement>('[data-bot-demo]');
  const video = demo?.querySelector<HTMLVideoElement>('[data-bot-video]');
  const section = demo?.closest<HTMLElement>('[data-live]');
  const asleep = document.getElementById('bot-sleep') as HTMLInputElement | null;

  if (demo && video && section) {
    let reduced = prefersReducedMotion();

    // Plays while the section is on screen, the tab is visible and the bot is awake or waking.
    // With reduced motion it never starts, so the poster stays.
    const sync = (): void => {
      const play = !reduced && !document.hidden && section.classList.contains('is-live') && !asleep?.checked;
      if (play && video.paused) video.play().catch(() => undefined);
      else if (!play && !video.paused) video.pause();
    };

    new MutationObserver(sync).observe(section, { attributes: true, attributeFilter: ['class'] });
    demo.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    onReducedMotionChange((value) => {
      reduced = value;
      sync();
      // Back to the poster rather than a frozen frame.
      if (value && video.played.length > 0) video.load();
    });
    sync();

    // Walk through the three states on its own until the visitor picks one.
    if (!reduced) {
      const order = [['bot-awake', 6000], ['bot-sleep', 4600], ['bot-wake', 2400]] as const;
      let step = 0;
      let timer = 0;
      let stopped = false;
      const schedule = (): void => {
        window.clearTimeout(timer);
        if (stopped) return;
        timer = window.setTimeout(() => {
          if (!section.classList.contains('is-live')) return schedule();
          step = (step + 1) % order.length;
          const input = document.getElementById(order[step]![0]) as HTMLInputElement | null;
          if (input) input.checked = true;
          // Setting `checked` from a script fires no change event.
          sync();
          schedule();
        }, order[step]![1]);
      };
      const stop = (): void => { stopped = true; window.clearTimeout(timer); };
      demo.addEventListener('pointerdown', stop, { once: true });
      demo.addEventListener('keydown', stop, { once: true });
      schedule();
    }
  }
</script>

<style>
  .botcard { padding: 22px; display: flex; flex-direction: column; gap: 18px; }
  .states { align-self: center; display: inline-flex; padding: 3px; gap: 2px; border-radius: 12px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--hair); }
  .states label { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 9px; font-size: 13px; color: var(--muted); cursor: pointer; transition: background-color var(--t-normal) var(--ease), color var(--t-normal) var(--ease); }
  .states label:hover { color: var(--ink); }
  .states i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .botcard:has(#bot-awake:checked) label[for='bot-awake'],
  .botcard:has(#bot-sleep:checked) label[for='bot-sleep'],
  .botcard:has(#bot-wake:checked) label[for='bot-wake'] { background: var(--ink); color: var(--on-ink); }
  .botcard:has(#bot-awake:checked) label[for='bot-awake'] i { background: var(--ok); }
  .botcard:has(#bot-awake:focus-visible) label[for='bot-awake'],
  .botcard:has(#bot-sleep:focus-visible) label[for='bot-sleep'],
  .botcard:has(#bot-wake:focus-visible) label[for='bot-wake'] { outline: 2px solid var(--focus); outline-offset: 2px; }

  /* The recording keeps its own flat grey in both themes, framed as a rounded card, at no more than its recorded size. */
  .stage {
    position: relative;
    align-self: center;
    width: 100%;
    max-width: 716px;
    aspect-ratio: 716 / 468;
    overflow: hidden;
    border-radius: 16px;
    background: var(--bot-stage);
    box-shadow: 0 0 0 1px var(--hair);
  }
  .stage video { display: block; width: 100%; height: 100%; object-fit: contain; transition: filter 0.8s var(--ease); }
  /* Asleep: paused (see the script) and dimmed. The slate band colour is dark in both themes. */
  .stage::after { content: ""; position: absolute; inset: 0; background: var(--band); opacity: 0; pointer-events: none; transition: opacity 0.8s var(--ease); }
  .botcard:has(#bot-sleep:checked) .stage::after { opacity: 0.16; }
  .botcard:has(#bot-sleep:checked) .stage video { filter: saturate(0.55); }

  .profile { display: flex; flex-wrap: wrap; gap: 8px; font-size: 12.5px; }
  .profile span { padding: 5px 10px; border-radius: 9px; background: var(--paper-deep); color: var(--muted); }
  .profile b { margin-left: 4px; color: var(--ink); font-weight: 600; }
  .works { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .works li { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 14px; overflow: hidden; border-radius: 12px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--hair); font-size: 13.5px; }
  .works i { position: absolute; left: 0; bottom: 0; width: 100%; height: 2px; background: var(--sage); transform-origin: left; transform: scaleX(0.4); animation: progress 9s var(--d, 0s) linear infinite; }
  @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .st { font-size: 12px; }
  .st b { display: none; font-weight: 500; }
  .botcard:has(#bot-awake:checked) .s-awake,
  .botcard:has(#bot-sleep:checked) .s-sleep,
  .botcard:has(#bot-wake:checked) .s-wake { display: inline; }
  .s-awake { color: var(--ok); }
  .s-awake.s-ask { color: var(--warn); }
  .s-sleep { color: var(--muted); }
  .s-wake { color: var(--sage); }
  .botcard:has(#bot-sleep:checked) .works i { animation-play-state: paused; opacity: 0.4; }
  .botcard:has(#bot-wake:checked) .works i { animation-duration: 2.4s; }
  .mem { display: flex; flex-wrap: wrap; gap: 8px; }
  .mem span { display: inline-flex; align-items: center; gap: 8px; padding: 6px 6px 6px 11px; border-radius: 10px; box-shadow: inset 0 0 0 1px var(--hair); font-size: 12.5px; }
  .mem em { padding: 2px 7px; border-radius: 6px; background: var(--paper-deep); color: var(--muted); font-size: 11px; font-style: normal; }
</style>
