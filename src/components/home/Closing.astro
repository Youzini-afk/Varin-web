---
import '~/styles/scene.css';
import Cube from '~/components/Cube.astro';
import DownloadButton from '~/components/DownloadButton.astro';
import { copyFor, type Locale } from '~/i18n';
import { DOCKER_GUIDE_URL, REPO_URL } from '~/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copyFor(locale).closing;
const pulses = [[-2, -1, 0], [1, -2, 1.6], [-1, -3, 3], [2, 0, 4.2], [-3, 1, 2.2]] as const;
---
<section class="closing" aria-labelledby="closing-title" data-live>
  <div class="mini" data-landing aria-hidden="true">
    <div class="scene">
      <div class="scene-mask">
        <div class="horizon">
          <div class="camera">
            <div class="floor-css">
              {pulses.map(([x, y, d]) => <i class="pulse" style={`--x:${x};--y:${y};--pd:${d}s`}></i>)}
            </div>
            <span class="contact"></span>
            <Cube />
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="kicker" data-reveal>{t.kicker}</p>
  <h2 id="closing-title" data-reveal style="--d:60ms">{t.title}</h2>
  <p class="desc" data-reveal style="--d:120ms">{t.body}</p>
  <div class="cta" data-reveal style="--d:180ms">
    <DownloadButton locale={locale} />
    <a class="btn btn-ghost" href={REPO_URL}>{t.github}</a>
    <a class="btn btn-ghost" href={DOCKER_GUIDE_URL}>{t.docker}</a>
  </div>
</section>

<style>
  .closing { padding: 32px var(--gutter) 128px; text-align: center; }
  .mini { position: relative; height: 300px; overflow: clip; }
  .mini .scene { --origin-y: 66%; --scene-scale: 0.82; --mask-w: 42%; }
  .pulse { position: absolute; left: calc(1344px + var(--x) * 96px); top: calc(1344px + var(--y) * 96px); width: 96px; height: 96px; background: var(--tile-strong); opacity: 0; animation: breathe 5.6s var(--pd) ease-in-out infinite; }
  @keyframes breathe { 0%, 100% { opacity: 0; } 50% { opacity: 0.6; } }
  .mini :global(.contact) { animation: contact-breathe 1.8s ease-in-out infinite; }
  @keyframes contact-breathe { 0%, 100% { opacity: 0.22; } 50% { opacity: 0.6; } }
  h2 { margin: 12px 0 14px; font-size: clamp(36px, 5vw, 64px); line-height: 1.12; letter-spacing: -0.04em; font-weight: 600; }
  .desc { margin: 0 auto; }
  .cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>
