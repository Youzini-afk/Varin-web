---
import HexIcon from '~/components/home/HexIcon.astro';
import Mark from '~/components/Mark.astro';
import { copyFor, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copyFor(locale).harness;
type CellKey = keyof typeof t.cells;

/**
 * A 3-4-5-4-3 honeycomb. The model is the centre; the inner ring holds the core of execution,
 * the outer ring the rest. `ring` sets when the wave reaches a cell.
 */
const rows: ReadonlyArray<ReadonlyArray<CellKey | 'core'>> = [
  ['output', 'prepare', 'tokens'],
  ['memory', 'tools', 'context', 'mcp'],
  ['isolation', 'team', 'core', 'durable', 'ask'],
  ['multirun', 'goals', 'replay', 'retry'],
  ['script', 'timeline', 'permissions'],
];
const inner = new Set<string>(['tools', 'context', 'team', 'durable', 'goals', 'replay']);
---
<section class="section center" id="harness" aria-labelledby="harness-title" data-live>
  <p class="kicker" data-reveal>{t.kicker}</p>
  <h2 class="title" id="harness-title" data-reveal style="--d:60ms">{t.title}</h2>
  <p class="desc" data-reveal style="--d:120ms">{t.desc}</p>

  <ul class="comb" data-reveal style="--d:160ms">
    {rows.map((row) => (
      <li class="row">
        <ul>
          {row.map((key) => key === 'core' ? (
            <li class="hex core"><div class="hx"><Mark class="core-mark" /><b>{t.core.title}</b><span>{t.core.body}</span></div></li>
          ) : (
            <li class:list={['hex', inner.has(key) ? 'ring1' : 'ring2']}>
              <div class="hx"><HexIcon name={key} /><b>{t.cells[key].title}</b><span>{t.cells[key].body}</span></div>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .comb {
    --hw: clamp(136px, 14.4vw, 172px);
    --hh: calc(var(--hw) * 1.1547);
    --hg: 7px;
    list-style: none;
    margin: 60px auto 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .row ul { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--hg); }
  /* Rows overlap by a quarter hexagon so every centre-to-centre distance equals the horizontal pitch. */
  .row + .row { margin-top: calc(var(--hh) / -4 + var(--hg) * 0.866); }
  .hex {
    --hex-bg: var(--card);
    position: relative;
    flex: none;
    width: var(--hw);
    height: var(--hh);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--line);
    transition: transform 0.45s var(--ease), background-color var(--t-normal) var(--ease);
  }
  .hex:hover { --hex-bg: var(--elev); z-index: 2; transform: scale(1.045); background: var(--ink); }
  .hx {
    position: absolute;
    inset: 1.2px;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 16%;
    background: var(--hex-bg);
    text-align: center;
    transition: background-color var(--t-normal) var(--ease);
  }
  /* A light wave travels out from the model, like the floor tiles in the splash. */
  .hx::after { content: ""; position: absolute; inset: 0; background: var(--tile-strong); opacity: 0; pointer-events: none; animation: wave 8s var(--wd, 0s) ease-in-out infinite; }
  .ring1 { --wd: 0.5s; }
  .ring2 { --wd: 1.1s; }
  @keyframes wave { 0%, 100% { opacity: 0; } 5% { opacity: 0.6; } 20% { opacity: 0; } }
  .hx > :global(*) { position: relative; z-index: 1; }
  .hx b { font-size: calc(var(--hw) * 0.084); line-height: 1.3; letter-spacing: -0.01em; text-wrap: balance; }
  .hx span { font-size: calc(var(--hw) * 0.068); line-height: 1.5; color: var(--muted); text-wrap: balance; }
  .core { --hex-bg: var(--ink); }
  .core:hover { --hex-bg: var(--ink); }
  .core .hx { color: var(--on-ink); }
  .core .hx::after { display: none; }
  .core .hx span { color: color-mix(in srgb, var(--on-ink) 62%, transparent); }
  .core :global(.core-mark) { --mark-a: var(--on-ink); --mark-b: var(--sage); width: calc(var(--hw) * 0.32); height: calc(var(--hw) * 0.32); margin-bottom: 6px; animation: core 2.4s ease-in-out infinite; }
  @keyframes core { 0%, 100% { filter: drop-shadow(0 0 0 transparent); } 50% { filter: drop-shadow(0 0 6px color-mix(in srgb, var(--on-ink) 70%, transparent)); } }

  @media (max-width: 760px) {
    .comb { --hw: 150px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; text-align: center; }
    .row, .row ul { display: contents; }
    .row + .row { margin-top: 0; }
    .hex { width: auto; height: auto; clip-path: none; border-radius: 16px; }
    .hx { position: relative; inset: auto; min-height: 132px; margin: 1px; padding: 18px 14px; clip-path: none; border-radius: 15px; }
    .core { grid-column: 1 / -1; order: -1; }
  }
</style>
