---
import { copyFor, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copyFor(locale).ready;
---
<section class="section" aria-labelledby="ready-title" data-live>
  <p class="kicker" data-reveal>{t.kicker}</p>
  <h2 class="title" id="ready-title" data-reveal style="--d:60ms">{t.title}{t.subtitle && <small>{t.subtitle}</small>}</h2>
  <div class="ready">
    <div class="card panel" data-reveal style="--d:120ms">
      <h3>{t.box.title}</h3>
      <p class="lead">{t.box.body}</p>
      <dl class="stats">
        {t.box.stats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
      </dl>
    </div>
    <div class="card panel" data-reveal style="--d:190ms">
      <h3>{t.custom.title}</h3>
      <p class="lead">{t.custom.body}</p>
      <ul class="toggles">{t.custom.items.map((item, index) => <li>{item}<span class="sw" style={`--i:${index}`} aria-hidden="true"></span></li>)}</ul>
    </div>
  </div>
  <div class="byok" data-reveal style="--d:120ms">
    <div>
      <h3>{t.byok.title}</h3>
      <p>{t.byok.body}</p>
    </div>
    <ul class="protos">
      {t.byok.protocols.map((name) => <li>{name}</li>)}
      {t.byok.local.map((name) => <li class="local">{name}</li>)}
      <li>{t.byok.any}</li>
    </ul>
  </div>
</section>

<style>
  .ready { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .panel { padding: 28px; }
  h3 { margin: 0 0 6px; font-size: 18px; letter-spacing: -0.015em; }
  .lead { margin: 0 0 22px; font-size: 13.5px; color: var(--muted); }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; padding: 1px; overflow: hidden; border-radius: 14px; background: var(--hair); }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 4px; padding: 16px 14px; background: var(--card); }
  dd { margin: 0; font-size: 30px; font-weight: 600; line-height: 1.1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  dt { font-size: 12px; line-height: 1.5; color: var(--muted); }
  .toggles { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .toggles li { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 12px 0; border-bottom: 1px solid var(--hair); font-size: 13.5px; line-height: 1.6; }
  .toggles li:last-child { border-bottom: 0; }
  .sw { position: relative; flex: none; width: 34px; height: 20px; border-radius: 999px; background: var(--ink); animation: sw-bg 8s calc(var(--i) * 0.5s) var(--ease) infinite; }
  .sw::after { content: ""; position: absolute; left: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--paper); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25); transform: translateX(14px); animation: sw-dot 8s calc(var(--i) * 0.5s) var(--ease) infinite; }
  @keyframes sw-bg { 0%, 10% { background: var(--line); } 16%, 100% { background: var(--ink); } }
  @keyframes sw-dot { 0%, 10% { transform: none; } 16%, 100% { transform: translateX(14px); } }

  .byok { margin-top: 16px; padding: 28px; border-radius: var(--radius-card); background: var(--band); color: var(--on-band); display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 32px; align-items: center; }
  .byok h3 { margin: 0 0 8px; font-size: 22px; letter-spacing: -0.02em; }
  .byok p { margin: 0; font-size: 13.5px; line-height: 1.75; color: rgba(238, 238, 232, 0.66); }
  .protos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .protos li { padding: 6px 11px; border-radius: 9px; box-shadow: inset 0 0 0 1px rgba(238, 238, 232, 0.16); font-family: var(--mono); font-size: 12px; transition: background-color var(--t-fast) var(--ease); }
  .protos li:hover { background: rgba(238, 238, 232, 0.08); }
  .protos .local { background: rgba(238, 238, 232, 0.1); }

  @media (max-width: 1080px) {
    .ready, .byok { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
