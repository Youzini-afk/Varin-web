---
import Mark from '~/components/Mark.astro';
import { copyFor, localePath, type Locale } from '~/i18n';
import {
  CHANGELOG_URL, DOCKER_GUIDE_URL, DOCS_URL, EXTENSION_GUIDE_URL, ISSUES_URL, LICENSE_URL, LINUXDO_URL, RELEASES_URL, REPO_URL,
} from '~/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = copyFor(locale);
const t = copy.footer;
const home = localePath(locale, '/');
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="inner">
    <div class="about">
      <a class="brand" href={home}><Mark class="footer-mark" /><span>Varin</span></a>
      <p>{t.tagline}</p>
      <p class="thanks">{t.thanks}</p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <h2>{t.columns.product}</h2>
        <a href={`${home}#team`}>{copy.nav.team}</a>
        <a href={`${home}#modes`}>{copy.nav.modes}</a>
        <a href={`${home}#bot`}>{copy.nav.bot}</a>
        <a href={`${home}#harness`}>{copy.nav.harness}</a>
        <a href={`${home}#extensions`}>{copy.nav.extensions}</a>
      </div>
      <div>
        <h2>{t.columns.resources}</h2>
        <a href={RELEASES_URL}>{t.links.releases}</a>
        <a href={CHANGELOG_URL}>{t.links.changelog}</a>
        <a href={DOCS_URL[locale]}>{t.links.docs}</a>
        <a href={EXTENSION_GUIDE_URL}>{t.links.extensions}</a>
        <a href={DOCKER_GUIDE_URL}>{t.links.docker}</a>
      </div>
      <div>
        <h2>{t.columns.community}</h2>
        <a href={REPO_URL}>{t.links.github}</a>
        <a href={ISSUES_URL}>{t.links.issues}</a>
        <a href={LINUXDO_URL}>{t.links.linuxdo}</a>
      </div>
    </nav>
  </div>
  <div class="legal">
    <span>© {year} Varin contributors</span>
    <a href={LICENSE_URL}>{t.license}</a>
  </div>
</footer>

<style>
  .footer { position: relative; z-index: 1; border-top: 1px solid var(--hair); background: var(--paper); }
  .inner { max-width: var(--page); margin: 0 auto; padding: 56px var(--gutter) 40px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; letter-spacing: -0.02em; }
  .brand :global(.footer-mark) { width: 20px; height: 20px; }
  .about p { margin: 14px 0 0; max-width: 28em; font-size: 13.5px; line-height: 1.7; color: var(--muted); }
  .about .thanks { margin-top: 6px; font-size: 12.5px; opacity: 0.8; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .cols div { display: flex; flex-direction: column; gap: 10px; }
  .cols h2 { margin: 0 0 4px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sage); }
  .cols a { font-size: 13.5px; color: var(--muted); width: fit-content; transition: color var(--t-fast) var(--ease); }
  .cols a:hover { color: var(--ink); }
  .legal { max-width: var(--page); margin: 0 auto; padding: 18px var(--gutter) 28px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--hair); }
  .legal a:hover { color: var(--ink); }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
