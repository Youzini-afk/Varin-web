---
// Replaces Starlight's theme bootstrap so the guides share the homepage's stored appearance (system, light, dark).
// Starlight styles key on a resolved data-theme, so "system" is resolved here before first paint.
import { THEME_STORAGE_KEY } from '~/lib/theme';
---
<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var stored = null;
    try { stored = localStorage.getItem(key); } catch (error) { /* storage unavailable: follow the system */ }
    root.dataset.theme = stored === 'light' || stored === 'dark'
      ? stored
      : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  })();
</script>
