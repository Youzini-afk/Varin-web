---
import { copyFor, LOCALES, localeInfo, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const current = localeInfo(locale);
const label = copyFor(locale).nav.language;
---
<details class="langs" data-lang-menu>
  <summary aria-label={`${label}: ${current.name}`} title={label}>
    <svg class="globe" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.4 2.4 3.5 5.2 3.5 8.5s-1.1 6.1-3.5 8.5c-2.4-2.4-3.5-5.2-3.5-8.5S9.6 5.9 12 3.5Z" /></svg>
    <span>{current.short}</span>
    <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
  </summary>
  <ul>
    {LOCALES.map((info) => (
      <li>
        <a
          href={localePath(info.code, path)}
          hreflang={info.htmlLang}
          lang={info.htmlLang}
          data-locale={info.code}
          aria-current={info.code === locale ? 'true' : undefined}
        >
          {info.name}
          {info.code === locale && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>}
        </a>
      </li>
    ))}
  </ul>
</details>

<script is:inline>
  document.addEventListener('click', function (event) {
    document.querySelectorAll('[data-lang-menu][open]').forEach(function (menu) {
      if (!menu.contains(event.target)) menu.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    document.querySelectorAll('[data-lang-menu][open]').forEach(function (menu) {
      menu.removeAttribute('open');
      var summary = menu.querySelector('summary');
      if (summary) summary.focus();
    });
  });
</script>

<style>
  .langs { position: relative; }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 8px 0 9px;
    border-radius: 10px;
    list-style: none;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--hair);
    background: var(--glass);
    transition: box-shadow var(--t-fast) var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .langs[open] summary { box-shadow: inset 0 0 0 1px var(--line); }
  svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .globe { width: 15px; height: 15px; color: var(--muted); }
  .chev { width: 13px; height: 13px; color: var(--muted); transition: transform var(--t-normal) var(--ease); }
  .langs[open] .chev { transform: rotate(180deg); }
  ul {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 50;
    min-width: 168px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 14px;
    background: var(--elev);
    box-shadow: 0 0 0 1px var(--hair), 0 22px 48px -24px var(--shadow);
    transform-origin: top right;
    animation: menu-in var(--t-normal) var(--ease) both;
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-4px) scale(0.98); } to { opacity: 1; transform: none; } }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 9px;
    font-size: 13.5px;
    color: var(--muted);
    font-family: var(--sans);
    transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  a:hover, a:focus-visible { background: var(--hl); color: var(--ink); }
  a[aria-current='true'] { color: var(--ink); font-weight: 600; }
  a svg { width: 15px; height: 15px; }
  @media (max-width: 400px) {
    .chev { display: none; }
    summary { padding: 0 9px; }
  }
</style>
