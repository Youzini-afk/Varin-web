---
import { copyFor, type Locale } from '~/i18n';

interface Props { locale: Locale }
const t = copyFor(Astro.props.locale).nav.theme;
---
<div class="seg" role="group" aria-label={t.label}>
  <button type="button" data-theme-choice="system" aria-pressed="true" title={t.system} aria-label={t.system}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16Z" class="fill" /></svg>
  </button>
  <button type="button" data-theme-choice="light" aria-pressed="false" title={t.light} aria-label={t.light}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false" title={t.dark} aria-label={t.dark}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" /></svg>
  </button>
</div>

<style>
  .seg { display: inline-flex; padding: 3px; gap: 2px; border-radius: 10px; background: var(--glass); box-shadow: inset 0 0 0 1px var(--hair); }
  button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 26px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  button:hover { color: var(--ink); }
  button[aria-pressed='true'] { background: var(--ink); color: var(--on-ink); }
  svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .fill { fill: currentColor; stroke: none; }
  /* Without scripts the buttons do nothing; the page follows the system appearance. */
  :global(html:not(.js)) .seg { display: none; }
</style>
