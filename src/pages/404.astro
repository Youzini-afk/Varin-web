---
import Mark from '~/components/Mark.astro';
import { copyFor, LOCALES, localePath } from '~/i18n';
import Base from '~/layouts/Base.astro';

// One 404 for the whole site. The requested path may belong to any language, so every homepage is offered.
const en = copyFor('en');
---
<Base locale="en" title="404 · Varin" path="/" indexable={false}>
  <section class="missing">
    <Mark class="missing-mark" />
    <h1>{en.notFound.title}</h1>
    <p>{en.notFound.body}</p>
    <ul class="homes">
      {LOCALES.map((info) => (
        <li><a class:list={['btn', info.code === 'en' ? 'btn-primary' : 'btn-ghost']} href={localePath(info.code, '/')} lang={info.htmlLang} hreflang={info.htmlLang}>{copyFor(info.code).notFound.home}</a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .missing { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 120px var(--gutter) 80px; text-align: center; }
  .missing :global(.missing-mark) { width: 56px; height: 56px; margin-bottom: 12px; }
  h1 { margin: 0; font-size: clamp(30px, 4vw, 48px); letter-spacing: -0.035em; }
  p { margin: 0; max-width: 34em; color: var(--muted); line-height: 1.8; }
  .homes { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .homes a { font-family: var(--sans); }
</style>
