---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '~/styles/tokens.css';
import '~/styles/base.css';
import { getImage } from 'astro:assets';
import socialCard from '~/assets/social-card.svg';
import Footer from '~/components/Footer.astro';
import Nav from '~/components/Nav.astro';
import { copyFor, DEFAULT_LOCALE, LOCALES, localeInfo, localePath, type Locale } from '~/i18n';
import { getLatestRelease } from '~/lib/release';
import { homeStructuredData, jsonForHtml } from '~/lib/seo';
import { THEME_STORAGE_KEY } from '~/lib/theme';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of this page without the locale prefix, used for alternates and the language menu. */
  path?: string;
  /** Pages without translated twins (such as the 404) skip canonical and hreflang links. */
  indexable?: boolean;
}
const { locale, path = '/', indexable = true } = Astro.props;
const t = copyFor(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const absolute = (href: string): string => new URL(href, Astro.site).href;
const image = await getImage({ src: socialCard, format: 'png', width: 1200, height: 630 });
const imageUrl = absolute(image.src);
const structuredData = indexable && path === '/' ? homeStructuredData(Astro.site!, locale, title, description) : null;
const releaseJson = jsonForHtml(await getLatestRelease());
---
<!doctype html>
<html lang={localeInfo(locale).htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfbf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161616" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Varin" />
    <meta property="og:locale" content={localeInfo(locale).ogLocale} />
    {indexable && LOCALES.filter((info) => info.code !== locale).map((info) => <meta property="og:locale:alternate" content={info.ogLocale} />)}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Varin · Open-source AI Agent Harness for coding, research and office work" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Varin · Open-source AI Agent Harness for coding, research and office work" />
    {indexable && <link rel="canonical" href={absolute(localePath(locale, path))} />}
    {indexable && <meta property="og:url" content={absolute(localePath(locale, path))} />}
    {indexable && LOCALES.map((info) => <link rel="alternate" hreflang={info.hreflang} href={absolute(localePath(info.code, path))} />)}
    {indexable && <link rel="alternate" hreflang="x-default" href={absolute(localePath(DEFAULT_LOCALE, path))} />}
    {indexable && <link rel="alternate" type="text/markdown" href={absolute(localePath(locale, '/index.md'))} title={`${title} (Markdown)`} />}
    <link rel="describedby" type="text/plain" href={absolute('/llms.txt')} title="Varin agent reading guide" />
    {structuredData && <script type="application/ld+json" is:inline set:html={jsonForHtml(structuredData)}></script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Applied before first paint: stored appearance and the script marker used by reveal styles. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var stored = localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
        } catch (error) { /* storage unavailable: follow the system */ }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Nav locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} path={path} />
    <script type="application/json" id="release-links" is:inline set:html={releaseJson}></script>
    <script>
      import '~/scripts/main';
    </script>
  </body>
</html>
